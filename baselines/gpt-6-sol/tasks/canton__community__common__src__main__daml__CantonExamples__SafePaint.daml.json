      "original": "-- Copyright (c) 2026 Digital Asset (Switzerland) GmbH and/or its affiliates. All rights reserved.\n-- SPDX-License-Identifier: Apache-2.0\n\nmodule LockIou where\n\nimport Iou (GetCash(..), Amount)\n\ntemplate LockableIou\n  with\n    payer: Party\n    owner: Party\n    amount: Amount\n  where\n    signatory payer\n    observer owner\n\n    choice Assign : ContractId LockedIou\n      with\n        beneficiary: Party\n      controller owner\n        do\n          create LockedIou with payer; owner; beneficiary; amount\n\n    choice Call : ContractId GetCash\n      controller owner\n        do\n          create GetCash with payer; owner; amount\n\ntemplate LockedIou\n  with\n    payer: Party\n    owner: Party\n    beneficiary: Party\n    amount: Amount\n  where\n    signatory payer\n    observer beneficiary, owner\n\n    choice Transfer : ContractId LockableIou\n      controller owner\n        do\n          create LockableIou with payer; owner = beneficiary; amount\n",
      "generated": "module LockIou where\n\nimport Iou (Amount)\n\ntemplate LockableIou\n  with\n    payer: Party\n    owner: Party\n    amount: Amount\n  where\n    signatory payer\n    observer owner\n\n    choice Assign : ContractId LockedIou\n      with beneficiary: Party\n      controller owner\n      do\n        create LockedIou with payer; owner; amount; beneficiary\n\n    choice Call : Amount\n      controller owner\n      do\n        pure amount\n\ntemplate LockedIou\n  with\n    payer: Party\n    owner: Party\n    amount: Amount\n    beneficiary: Party\n  where\n    signatory payer\n    observer owner, beneficiary\n\n    choice Transfer : ContractId LockableIou\n      controller owner\n      do\n        create LockableIou with payer; owner = beneficiary; amount\n",
