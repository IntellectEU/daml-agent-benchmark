      "original": "-- Copyright (c) 2025 Digital Asset (Switzerland) GmbH and/or its affiliates. All rights reserved.\n-- SPDX-License-Identifier: Apache-2.0\n\nmodule Intro.Asset.MultiTrade where\n\nimport DA.List\n\nimport Intro.Asset\nimport DA.Foldable (mapA_)\n\nbaseOwner : MultiTrade -> Party\nbaseOwner MultiTrade { baseAssets } = (head baseAssets).owner\n\nquoteOwner : MultiTrade -> Party\nquoteOwner MultiTrade { quoteAssets } = (head quoteAssets).owner\n\ntemplate MultiTrade\n  with\n    baseAssetCids : [ContractId Asset]\n    baseAssets : [Asset]\n    quoteApprovalCids : [ContractId TransferApproval]\n    quoteAssets : [Asset]\n  where\n    signatory baseOwner this\n    observer quoteOwner this\n    -- ENSURE_BEGIN\n    ensure (length baseAssetCids == length baseAssets) &&\n      (length quoteApprovalCids == length quoteAssets) &&\n      not (null baseAssets) &&\n      not (null quoteAssets)\n    -- ENSURE_END\n\n    choice Trade_Cancel\n      : ()\n      controller baseOwner this\n      do\n        return ()\n\n    choice Trade_Reject\n      : ()\n      controller quoteOwner this\n      do\n        return ()\n\n    choice Trade_Settle\n      : ([ContractId Asset], [ContractId Asset])\n      with\n        quoteAssetCids : [ContractId Asset]\n        baseApprovalCids : [ContractId TransferApproval]\n      controller quoteOwner this\n      do\n        assertMsg\n          \"Wrong number of quoteAssetCids\"\n          (length quoteAssetCids == length quoteAssets)\n        assertMsg\n          \"Wrong number of baseApprovalCids\"\n          (length baseApprovalCids == length baseAssets)\n\n-- LOCAL_FUNCTIONS_BEGIN\n        let\n          validate (asset, assetCid) = do\n            fetchedAsset <- fetch assetCid\n            assertMsg\n              \"Asset mismatch\"\n              (asset == fetchedAsset with\n                observers = asset.observers)\n\n        mapA_ validate (zip baseAssets baseAssetCids)\n        mapA_ validate (zip quoteAssets quoteAssetCids)\n\n        let\n          transfer (assetCid, approvalCid) = do\n            exercise approvalCid TransferApproval_Transfer with assetCid\n\n        transferredBaseCids <- mapA transfer (zip baseAssetCids baseApprovalCids)\n        transferredQuoteCids <- mapA transfer (zip quoteAssetCids quoteApprovalCids)\n-- LOCAL_FUNCTIONS_END\n\n        return (transferredBaseCids, transferredQuoteCids)\n",
      "generated": "module Intro.Asset.MultiTrade where\n\nimport Intro.Asset\n\ntemplate MultiTrade\n  with\n    baseAssetCids : [ContractId Asset]\n    baseAssets : [Asset]\n    quoteApprovalCids : [ContractId TransferApproval]\n    quoteAssets : [Asset]\n  where\n    signatory map (\\asset -> asset.owner) baseAssets\n    observer map (\\asset -> asset.owner) quoteAssets\n    ensure length baseAssetCids == length baseAssets\n      && length quoteApprovalCids == length quoteAssets\n\n    choice Trade_Cancel : ()\n      controller map (\\asset -> asset.owner) baseAssets\n      do return ()\n\n    choice Trade_Reject : ()\n      controller map (\\asset -> asset.owner) quoteAssets\n      do return ()\n\n    choice Trade_Settle\n      : ([ContractId Asset], [ContractId Asset])\n      with\n        quoteAssetCids : [ContractId Asset]\n        baseApprovalCids : [ContractId TransferApproval]\n      controller map (\\asset -> asset.owner) quoteAssets\n      do\n        assertMsg \"Base approval count mismatch\"\n          (length baseApprovalCids == length baseAssets)\n        assertMsg \"Quote asset count mismatch\"\n          (length quoteAssetCids == length quoteAssets)\n\n        mapA (\\(assetCid, expectedAsset) -> do\n          actualAsset <- fetch assetCid\n          assertMsg \"Base asset mismatch\"\n            (expectedAsset == actualAsset with\n              observers = expectedAsset.observers)\n          ) (zip baseAssetCids baseAssets)\n\n        mapA (\\(assetCid, expectedAsset) -> do\n          actualAsset <- fetch assetCid\n          assertMsg \"Quote asset mismatch\"\n            (expectedAsset == actualAsset with\n              observers = expectedAsset.observers)\n          ) (zip quoteAssetCids quoteAssets)\n\n        transferredBaseCids <- mapA (\\(approvalCid, assetCid) ->\n          exercise approvalCid TransferApproval_Transfer with\n            assetCid\n          ) (zip baseApprovalCids baseAssetCids)\n\n        transferredQuoteCids <- mapA (\\(approvalCid, assetCid) ->\n          exercise approvalCid TransferApproval_Transfer with\n            assetCid\n          ) (zip quoteApprovalCids quoteAssetCids)\n\n        return (transferredBaseCids, transferredQuoteCids)\n",
