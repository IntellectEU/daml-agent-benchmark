      "original": "-- Copyright (c) 2019 Digital Asset (Switzerland) GmbH and/or its affiliates. All rights reserved.\n-- SPDX-License-Identifier: Apache-2.0\n\nmodule Auction where\n\nimport DA.List\n\n-- Used both to indicate a bid, and to show the final allocations.\ndata Allocation = Allocation with \n  party: Party\n  price: Decimal\n  quantity: Int\n    deriving (Show, Eq)\n\n-- Given the remaining quantity and requested allocation amount,\n-- calculate the resulting quantity and allocation.\nallocBids: Int -> Allocation -> (Int, Allocation)\nallocBids 0 a = (0, a with quantity = 0)\nallocBids remQty a = if remQty >= a.quantity then (remQty - a.quantity, a)\n                     else (0, a with quantity = remQty)\n\n-- Auction template visible only to the seller.\ntemplate Auction\n  with\n    security: Text\n    quantity: Int\n    seller: Party\n    start: Time\n    end: Time\n  where\n    ensure quantity > 0 && start < end\n    signatory seller\n    -- Sent individually to each participant (bidder) at start of auction.\n    nonconsuming choice InviteBidder: ContractId AuctionInvitation \n        with buyer: Party\n        controller seller\n          do create AuctionInvitation with buyer; auction = this\n    -- This should be triggered externally at the auction end time.\n    -- Collect the bids and publish allocations in `AuctionResult`.\n    choice CompleteAuction: ContractId AuctionResult\n        with bidIds: [ContractId Bid]\n        controller seller\n        do \n          bids <- mapA (\\id -> fetch id) bidIds\n          let requestedAllocs = map (\\x -> x.allocation) bids\n              sortedAllocs = (sortOn (\\x -> Down x.price) ) requestedAllocs\n              finalAllocs = mapAccumL allocBids this.quantity sortedAllocs -- TODO: filter qty = 0 allocs?\n          create AuctionResult with auction = this; allocations = finalAllocs._2\n\n-- Private to each buyer; contains a copy of the main Auction contract.\ntemplate AuctionInvitation\n  with\n    auction: Auction\n    buyer: Party\n  where\n    signatory auction.seller\n    controller buyer can \n      SubmitBid: ContractId Bid\n        with price: Decimal, quantity: Int\n        do\n          now <- getTime\n          assert(now <= auction.end &&\n                 now >= auction.start)\n          create Bid with auction; allocation = Allocation with party = buyer; price; quantity\n\n-- Used to place a bid on an active auction.\ntemplate Bid\n  with\n    auction: Auction\n    allocation: Allocation\n  where\n    signatory allocation.party\n    observer auction.seller\n\n-- Created on successful completion of an auction, to display allocs.\ntemplate AuctionResult\n  with\n    auction: Auction\n    allocations: [ Allocation ]\n  where\n    signatory auction.seller\n    observer map (\\x -> x.party) allocations",
      "generated": "module Auction where\n\nimport DA.List (sortBy)\n\ntemplate Auction\n  with\n    security : Text\n    quantity : Int\n    seller : Party\n    start : Time\n    end : Time\n  where\n    signatory seller\n    ensure quantity > 0 && start < end\n\n    nonconsuming choice InviteBidder : ContractId Invitation\n      with buyer : Party\n      controller seller\n      do\n        create Invitation with auctionId = self; seller; buyer; start; end\n\n    choice CompleteAuction : [ContractId Allocation]\n      with bidIds : [ContractId Bid]\n      controller seller\n      do\n        bids <- mapA fetch bidIds\n        let rankedBids = sortBy (\\(_, left) (_, right) -> compare right.price left.price) (zip bidIds bids)\n        allocateBids self seller security quantity rankedBids\n\ntemplate Invitation\n  with\n    auctionId : ContractId Auction\n    seller : Party\n    buyer : Party\n    start : Time\n    end : Time\n  where\n    signatory seller\n    observer buyer\n\n    choice SubmitBid : ContractId Bid\n      with\n        price : Decimal\n        quantity : Int\n      controller buyer\n      do\n        now <- getTime\n        assert (start <= now && now <= end)\n        assert (price > 0.0 && quantity > 0)\n        create Bid with auctionId; seller; buyer; price; quantity\n\ntemplate Bid\n  with\n    auctionId : ContractId Auction\n    seller : Party\n    buyer : Party\n    price : Decimal\n    quantity : Int\n  where\n    signatory buyer\n    observer seller\n\n    choice CloseBid : ()\n      controller seller\n      do pure ()\n\ntemplate Allocation\n  with\n    seller : Party\n    buyer : Party\n    security : Text\n    price : Decimal\n    quantity : Int\n  where\n    signatory seller\n    observer buyer\n\nallocateBids : ContractId Auction -> Party -> Text -> Int -> [(ContractId Bid, Bid)] -> Update [ContractId Allocation]\nallocateBids auctionId seller security remaining bids = case bids of\n  [] -> pure []\n  (bidId, bid) :: rest -> do\n    assert (bid.auctionId == auctionId)\n    assert (bid.seller == seller)\n    exercise bidId CloseBid\n    if remaining <= 0 then\n      allocateBids auctionId seller security remaining rest\n    else do\n      let filled = min remaining bid.quantity\n      allocationId <- create Allocation with\n        seller\n        buyer = bid.buyer\n        security\n        price = bid.price\n        quantity = filled\n      others <- allocateBids auctionId seller security (remaining - filled) rest\n      pure (allocationId :: others)\n",
