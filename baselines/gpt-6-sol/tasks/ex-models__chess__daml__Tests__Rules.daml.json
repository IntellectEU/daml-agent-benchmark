      "original": "-- Copyright (c) 2019 Digital Asset (Switzerland) GmbH and/or its affiliates. All rights reserved.\n-- SPDX-License-Identifier: Apache-2.0\n\nmodule Rules.Move where\n\nimport DA.Foldable\nimport DA.Map as M\nimport DA.Optional\n\nimport Types\n\nimport Rules.EnPassant\nimport Rules.Data\nimport Rules.Path\nimport Rules.Promotion\nimport Rules.Util\n\n-- | Helper function to apply a simple chess move to\nsimpleMove : MoveData -> E StateMap\nsimpleMove md = do\n  capture <- checkCapture md\n  newType <- checkPromotion md\n  let\n    target = fromOptional md.to capture\n    isCapture = isSome capture\n  movePath <- path md.piece.tp md.state.player isCapture md.from md.to\n\n  forA_ movePath (\\c -> assertMsg \"Path blocked\" (isNone $ M.lookup c md.stateMap))\n\n  return $\n    M.insert md.to\n      (movePiece md.move.to md.piece) with tp = newType\n      (M.delete target\n        (M.delete md.from md.stateMap))\n\n\n-- | Checks whether a chess move is a capture, ie whether an opponent\n-- | piece gets taken. Fails if the `to` field has piece by the player\ncheckCapture : MoveData -> E Capture\ncheckCapture md = do\n  -- Which piece may the player be trying to take?\n  tgt <- target md\n  let\n    tgtPiece = M.lookup tgt md.stateMap\n    tgtCoord = fmap coord tgtPiece\n    toOwner = do\n      piece <- M.lookup md.to md.stateMap\n      return piece.owner\n\n  assertMsg \"Can't capture own piece\" (toOwner /= Some md.state.player)\n  return $ fmap toIntCoord tgtCoord\n",
      "generated": "module Rules.Move where\n\nimport DA.Foldable\nimport DA.Map as M\nimport DA.Optional\n\nimport Types\nimport Rules.Data\nimport Rules.EnPassant\nimport Rules.Path\nimport Rules.Promotion\nimport Rules.Util\n\ncheckCapture : MoveData -> E (Optional IntCoord)\ncheckCapture md = do\n  let destination = M.lookup md.to md.stateMap\n  captureCoord <- if md.piece.tp == Pawn && md.from._1 /= md.to._1 && isNone destination\n    then target md\n    else return md.to\n  case M.lookup captureCoord md.stateMap of\n    None -> return None\n    Some piece -> do\n      assertMsg \"Cannot capture own piece\" (piece.owner /= md.piece.owner)\n      return (Some captureCoord)\n\nsimpleMove : MoveData -> E StateMap\nsimpleMove md = do\n  capture <- checkCapture md\n  movePath <- path md.piece.tp md.piece.owner (isSome capture) md.from md.to\n  forA_ movePath (\\coord -> assertMsg \"Path blocked\" (isNone $ M.lookup coord md.stateMap))\n  pieceType <- checkPromotion md\n  let movedPiece = (movePiece md.move.to md.piece) with tp = pieceType\n      withoutSource = M.delete md.from md.stateMap\n      withoutCapture = case capture of\n        None -> withoutSource\n        Some coord -> M.delete coord withoutSource\n  return $ M.insert md.to movedPiece withoutCapture\n",
