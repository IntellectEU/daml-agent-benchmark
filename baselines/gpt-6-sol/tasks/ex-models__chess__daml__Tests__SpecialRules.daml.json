      "original": "-- Copyright (c) 2019 Digital Asset (Switzerland) GmbH and/or its affiliates. All rights reserved.\n-- SPDX-License-Identifier: Apache-2.0\n\nmodule Rules.EnPassant where\n\nimport DA.Either\nimport DA.List as L\nimport DA.Map as M\n\nimport Types\n\nimport Rules.Data\n\n-- | Evaluates the target of a potential capture.\n-- | Returns the `to` coordinate unless an En Passant is detected\ntarget : MoveData -> E IntCoord\ntarget md =\n  if L.null md.state.moves\n    then return md.to\n    else targetInner md\n\ntargetInner : MoveData -> E IntCoord\ntargetInner md = do\n  let lastMove = head md.state.moves\n      lmTo = toIntCoord lastMove.to\n      lmFrom = toIntCoord lastMove.from\n  lastMovePiece <- optionalToEither\n    \"Unexpected error: Piece not found.\"\n    (M.lookup lmTo md.stateMap)\n  let\n    lastMoveMatch = lastMovePiece.tp == Pawn\n          && rowD lmTo lmFrom == 2\n    targetMatch = epTarget == lmTo\n    tgt = if lastMoveMatch && targetMatch && md.piece.tp == Pawn\n      then epTarget\n      else md.to\n  return tgt\n\n  where\n    epTarget = (md.to._1, md.from._2)\n    oEpTargetPiece = M.lookup epTarget md.stateMap",
      "generated": "module Rules.EnPassant where\n\nimport DA.Either\nimport DA.Map as M\nimport DA.Optional\n\nimport Types\nimport Rules.Data\n\ntarget : MoveData -> E IntCoord\ntarget md\n  | md.piece.tp /= Pawn || md.from._1 == md.to._1 = Right md.to\n  | isSome (M.lookup md.to md.stateMap) = Right md.to\n  | otherwise = do\n      let captured = (md.to._1, md.from._2)\n          previous = md.state.moves\n      pawn <- optionalToEither \"Invalid en passant\" (M.lookup captured md.stateMap)\n      assertMsg \"Invalid en passant\" (pawn.tp == Pawn && pawn.owner /= md.state.player)\n      case previous of\n        lastMove :: _ -> do\n          let lastFrom = toIntCoord lastMove.from\n              lastTo = toIntCoord lastMove.to\n          assertMsg \"Invalid en passant\" (lastTo == captured && colD lastFrom lastTo == 0 && rowD lastFrom lastTo == 2)\n          Right captured\n        [] -> Left \"Invalid en passant\"\n",
      "captured_at_utc": "2026-09-25T15:55:05.305538+00:00"
    },
