      "original": "-- Copyright (c) 2019 Digital Asset (Switzerland) GmbH and/or its affiliates. All rights reserved.\n-- SPDX-License-Identifier: Apache-2.0\n\nmodule Rules.Castle where\n\nimport DA.Either\nimport DA.Foldable\nimport DA.Optional\nimport DA.Map as M\n\n\nimport Types\n\nimport Rules.Data\nimport Rules.Util\n\n-- | Checks whether the move is a castle\nisCastle : MoveData -> Bool\nisCastle md =\n  md.piece.tp == King &&\n  colD md.from md.to == 2\n\n-- | Helper function to apply the special \"castle\" chess move\ncastle : MoveData -> E StateMap\ncastle md = do\n  let\n    everCheck =\n      if md.state.player == White\n        then md.state.everCheck._1\n        else md.state.everCheck._2\n  assertMsg \"Move an unmoved, unchecked King to castle\"\n    (md.piece.tp == King && not md.piece.moved && not everCheck)\n\n  (rookFromCoord, rookToCoord) <-\n    case (md.state.player, md.move.to) of\n      (White, G1) -> return (H1, F1)\n      (white, C1) -> return (A1, C1)\n      (Black, G8) -> return (H8, F8)\n      (Black, G1) -> return (A8, C8)\n      _           -> abort \"Invalid target for castle\"\n  let rookFrom = toIntCoord rookFromCoord\n      rookTo = toIntCoord rookToCoord\n  rook <- optionalToEither \"Rook position not occupied\" $ M.lookup rookFrom md.stateMap\n  assertMsg \"Castling needs an unmoved rook\"\n    (rook.tp == Rook && not rook.moved)\n\n  movePath <- pathBetween md.from rookFrom\n  forA_ movePath (\\c -> assertMsg \"Path blocked\" (isNone $ M.lookup c md.stateMap))\n\n  return $\n    M.insert md.to\n      (movePiece md.move.to md.piece)\n      (M.insert rookTo\n        (movePiece rookToCoord rook)\n        (M.delete rookFrom\n          (M.delete md.from md.stateMap)))\n",
      "generated": "module Rules.Castle where\n\nimport DA.Either\nimport DA.Foldable as F\nimport DA.Map as M\nimport DA.Optional\n\nimport Types\nimport Rules.Data\nimport Rules.Util\n\nisCastle : MoveData -> Bool\nisCastle md = md.piece.tp == King && rowD md.from md.to == 0 && colD md.from md.to == 2\n\ncastle : MoveData -> E StateMap\ncastle md = do\n  let (fromCol, row) = md.from\n      (toCol, _) = md.to\n      rookCol = if toCol > fromCol then 7 else 0\n      rookFrom = (rookCol, row)\n      rookTo = (if toCol > fromCol then toCol - 1 else toCol + 1, row)\n      between = if toCol > fromCol then [fromCol + 1 .. rookCol - 1] else [rookCol + 1 .. fromCol - 1]\n  assertMsg \"King has moved\" (not md.piece.moved)\n  assertMsg \"King has been checked\" (if md.state.player == White then not md.state.everCheck._1 else not md.state.everCheck._2)\n  rook <- optionalToEither \"Rook position not occupied\" (M.lookup rookFrom md.stateMap)\n  assertMsg \"Invalid rook for castling\" (rook.tp == Rook && rook.owner == md.state.player && not rook.moved)\n  F.forA_ between (\\col -> assertMsg \"Castling path blocked\" (isNone (M.lookup (col, row) md.stateMap)))\n  return $ M.insert md.to (movePiece md.move.to md.piece)\n    (M.insert rookTo (movePiece (toCoord rookTo) rook)\n      (M.delete rookFrom (M.delete md.from md.stateMap)))\n",
