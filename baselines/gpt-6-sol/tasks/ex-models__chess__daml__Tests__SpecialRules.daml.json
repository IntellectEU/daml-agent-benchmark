      "original": "-- Copyright (c) 2019 Digital Asset (Switzerland) GmbH and/or its affiliates. All rights reserved.\n-- SPDX-License-Identifier: Apache-2.0\n\nmodule Rules.Promotion where\n\nimport Types\n\nimport Rules.Data\n\n-- | Checks whether a promotion is being performed and returns the\n-- | new piece type\ncheckPromotion : MoveData -> E PieceType\ncheckPromotion md = case md.move.promote of\n    Some t -> do\n      assertMsg \"Promotion not allowed\" (md.piece.tp == Pawn &&\n        (md.state.player == Black && md.to._2 == 0) ||\n        (md.state.player == White && md.to._2 == 7)\n        )\n      return t\n    _ -> return $ md.piece.tp\n",
      "generated": "module Rules.Promotion where\n\nimport Types\nimport Rules.Data\n\ncheckPromotion : MoveData -> E PieceType\ncheckPromotion md =\n  case md.move.promote of\n    None -> do\n      assertMsg \"Pawn must promote\" (md.piece.tp /= Pawn || not finalRank)\n      Right md.piece.tp\n    Some newType -> do\n      assertMsg \"Only pawns can promote\" (md.piece.tp == Pawn && finalRank)\n      assertMsg \"Invalid promotion piece\" (newType `elem` [Queen, Rook, Bishop, Knight])\n      Right newType\n  where\n    finalRank = md.to._2 == (if md.state.player == White then 7 else 0)\n",
