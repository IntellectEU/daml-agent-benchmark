      "end": "(?=\\)|$|,|}|\\b(in|then|else|of|with)\\b(?!')|(?<![\\p{S}\\p{P}&&[^(),;\\[\\]`{}_\"']])(?:(\\\\|<\\-|=))([(),;\\[\\]`{}_\"']|[^\\p{S}\\p{P}]))",
