          "include": "#type_signature"
        }
      ],
      "name": "meta.type-declaration.daml"
    },
    {
      "comment": "In case this regex seems overly general, note that daml permits the definition of new operators which can be nearly any string of punctuation characters, such as $%^&*.",
      "match": "[\\p{S}\\p{P}&&[^(),;\\[\\]`{}_\"']]+",
      "name": "keyword.operator.daml"
