        "3": {
          "name": "constant.character.escape.octal.daml"
        },
        "4": {
          "name": "constant.character.escape.hexadecimal.daml"
        },
        "5": {
          "name": "constant.character.escape.control.daml"
        },
        "6": {
          "name": "punctuation.definition.string.end.daml"
